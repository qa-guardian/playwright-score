{
  "name": "@qaguardian/playwright-score",
  "version": "0.1.2",
  "description": "Deterministic, AI-free Playwright spec quality score (sqs-v1). Lint + score with standard and guardian profiles.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "playwright-score": "bin/playwright-score.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "bin",
    "dist",
    "METHODOLOGY.md",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc && node -e \"require('fs').chmodSync('dist/cli.js',0o755); require('fs').chmodSync('bin/playwright-score.js',0o755)\"",
    "build:tests": "tsc -p tsconfig.tests.json",
    "test": "npm run build && npm run build:tests && node --test dist-tests/tests/*.js",
    "score": "npm run build && node bin/playwright-score.js",
    "dogfood": "npm run build && bash scripts/dogfood.sh",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "playwright",
    "eslint",
    "testing",
    "quality",
    "score",
    "lint",
    "e2e"
  ],
  "license": "MIT",
  "author": "QA Guardian <qag@qaguardian.com> (https://qaguardian.com)",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qa-guardian/playwright-score.git"
  },
  "bugs": {
    "url": "https://github.com/qa-guardian/playwright-score/issues"
  },
  "homepage": "https://qaguardian.com/open-source/playwright-score",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@typescript-eslint/parser": "^8.18.0",
    "eslint": "^9.17.0",
    "eslint-plugin-playwright": "^2.1.0",
    "glob": "^11.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.2"
  }
}
