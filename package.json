{
  "name": "@qaguardian/playwright-score",
  "version": "3.0.0",
  "description": "Deterministic, AI-free Playwright spec quality score — the weighted share of your tests that are clean.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "pwscore": "bin/playwright-score.js",
    "playwright-score": "bin/playwright-score.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "bin",
    "dist",
    "METHODOLOGY.md",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc && node scripts/copy-catalogue-data.mjs dist && node -e \"require('fs').chmodSync('dist/cli.js',0o755); require('fs').chmodSync('bin/playwright-score.js',0o755)\"",
    "build:tests": "tsc -p tsconfig.tests.json && node scripts/copy-catalogue-data.mjs dist-tests/src",
    "test": "npm run build && npm run build:tests && node --test dist-tests/tests/*.js",
    "score": "npm run build && node bin/playwright-score.js",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "playwright",
    "eslint",
    "testing",
    "quality",
    "score",
    "lint",
    "e2e"
  ],
  "license": "MIT",
  "author": "QA Guardian <qag@qaguardian.com> (https://qaguardian.com)",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qa-guardian/playwright-score.git"
  },
  "bugs": {
    "url": "https://github.com/qa-guardian/playwright-score/issues"
  },
  "homepage": "https://qaguardian.com/open-source/playwright-score",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@typescript-eslint/parser": "8.65.0",
    "eslint": "9.39.5",
    "eslint-plugin-playwright": "2.11.0",
    "glob": "11.1.0",
    "typescript": "5.9.3"
  },
  "bundleDependencies": [
    "@typescript-eslint/parser",
    "eslint",
    "eslint-plugin-playwright",
    "glob",
    "typescript"
  ],
  "devDependencies": {
    "@types/node": "^22.10.0"
  }
}
