{
  "name": "monorepo-root",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "monorepo-root",
      "workspaces": [
        "packages/*"
      ]
    },
    "node_modules/@playwright/test": {
      "resolved": "packages/playwright-test",
      "link": true
    },
    "node_modules/playwright-core": {
      "resolved": "packages/playwright",
      "link": true
    },
    "packages/playwright-test": {
      "name": "@playwright/test",
      "version": "0.0.0"
    }
  }
}
